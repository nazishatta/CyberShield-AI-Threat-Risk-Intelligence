# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Data — never commit raw or processed datasets ────────────────────────────
data/raw/
data/processed/
data/cache/
*.csv
*.tsv
*.parquet
*.feather
*.ndjson
# Exception: tiny curated sample files in data/samples/ ARE tracked
!data/samples/**

# ── Model artefacts ──────────────────────────────────────────────────────────
# Leading slash anchors to the repository root only — src/models/ is NOT ignored
/models/
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.npy
*.npz
*.safetensors

# ── Generated reports / figures ──────────────────────────────────────────────
reports/figures/*.png
reports/figures/*.svg
reports/figures/*.pdf
reports/figures/*.jpg
reports/figures/*.html
# Keep the placeholder so Git tracks the folder
!reports/figures/.gitkeep

# ── Secrets / credentials ────────────────────────────────────────────────────
.env
*.pem
*.key
secrets/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Coverage / test artefacts ────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
